---
import { getCollection } from 'astro:content';
import { categories } from '../../consts';

const projects = await getCollection('projects');
const sorted = projects
  .map((p) => ({ ...p.data, id: p.id }))
  .sort((a, b) => a.order - b.order);

const visibleSorted = sorted.filter((p) => p.category !== 'cache');
const featured = visibleSorted[0];
const rest = visibleSorted.slice(1);

const firstProject = sorted[0];

// Libellés de catégorie pour les tuiles (i18n via setLang)
const catLabels: Record<string, string> = {
  youtube: 'YouTube',
  'court-metrage': 'Courts-Métrages',
  'reseaux-sociaux': 'Réseaux Sociaux',
};
const catI18n: Record<string, string> = {
  youtube: 'categories.youtube',
  'court-metrage': 'categories.courtMetrage',
  'reseaux-sociaux': 'categories.reseauxSociaux',
};

const featuredIds = featured ? resolveVideoIds(featured) : { youtubeId: '', vimeoId: '' };
const featuredHasVideo = featured
  ? !!(featured.videoUrl || featured.videoFile || featuredIds.youtubeId || featuredIds.vimeoId || (featured.preview && /\.(mp4|webm|mov)$/i.test(featured.preview)))
  : false;

function ytThumb(id: string, size = 'hqdefault') {
  if (import.meta.env.DEV) {
    return `https://img.youtube.com/vi/${id}/${size}.jpg`;
  }
  return `/yt-thumb/${id}?size=${size}`;
}

function thumbnailUrl(project: typeof sorted[number]) {
  if (project.youtubeId) {
    return ytThumb(project.youtubeId);
  }
  if (project.vimeoId) {
    return project.thumbnail || '/placeholder-thumb.webp';
  }
  return project.thumbnail || '/placeholder-thumb.webp';
}

function thumbnailSrcset(youtubeId: string) {
  return `${ytThumb(youtubeId, 'mqdefault')} 320w, ${ytThumb(youtubeId)} 480w, ${ytThumb(youtubeId, 'sddefault')} 640w`;
}

function posterUrl(preview: string) {
  return preview.replace(/\.(webm|mp4|mov)$/i, '-poster.webp');
}

function firstProjectThumb() {
  if (firstProject.preview && /\.(mp4|webm|mov)$/i.test(firstProject.preview)) {
    return posterUrl(firstProject.preview);
  }
  return thumbnailUrl(firstProject);
}

function extractYoutubeId(url: string): string | null {
  const patterns = [
    /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/|youtube\.com\/shorts\/)([a-zA-Z0-9_-]{11})/,
  ];
  for (const p of patterns) {
    const m = url.match(p);
    if (m) return m[1];
  }
  return null;
}

function extractVimeoId(url: string): string | null {
  const m = url.match(/vimeo\.com\/(\d+)/);
  return m ? m[1] : null;
}

function resolveVideoIds(project: typeof sorted[number]) {
  let youtubeId = project.youtubeId || '';
  let vimeoId = project.vimeoId || '';
  if (!youtubeId && !vimeoId && project.videoUrl) {
    youtubeId = extractYoutubeId(project.videoUrl) || '';
    if (!youtubeId) vimeoId = extractVimeoId(project.videoUrl) || '';
  }
  return { youtubeId, vimeoId };
}

function aspectClass(ratio: string) {
  switch (ratio) {
    case '9:16': return 'aspect-[9/16]';
    case '1:1': return 'aspect-square';
    default: return 'aspect-video';
  }
}

---

<link rel="preload" as="image" href={firstProjectThumb()} fetchpriority="high" />

<section id="projects" class="relative z-10 w-full">
  <!-- À la une — bento d'ouverture -->
  {featured && (
  <div id="hero-band" class="relative z-10 px-4 md:px-6 pb-5 md:pb-6 reveal-up">
    <div class="mx-auto max-w-6xl grid grid-cols-1 lg:grid-cols-3 gap-4 md:gap-6">
      <div id="hero-slot" class="lg:col-span-2 min-w-0">
      <article
        id="hero-featured"
        class={`project-card group overflow-hidden bg-brand-gray-900 border-0 rounded-[14px] w-full ${aspectClass(featured.aspectRatio || '16:9')}`}
        data-category={featured.category || 'youtube'}
        data-youtube={featuredIds.youtubeId}
        data-vimeo={featuredIds.vimeoId}
        data-title={featured.title}
        data-video={featured.videoUrl || ''}
        data-video-file={featured.videoFile || ''}
        data-preview={featured.preview || ''}
        data-client={featured.client || ''}
        data-description={featured.description || ''}
        data-tags={(featured.tags || []).join(',')}
        data-aspect={featured.aspectRatio || '16:9'}
        data-order={featured.order}
        tabindex="0" role="button" aria-label={featured.title}
        onclick={featuredHasVideo || featured.preview ? 'openVideo(this)' : undefined}
      >
        {featured.preview && /\.(mp4|webm|mov)$/i.test(featured.preview) ? (
          <video loop muted playsinline preload="none"
            poster={posterUrl(featured.preview)}
            class="block w-full h-full object-cover lazy-video blur-up"
          >
            <source src={featured.preview} type="video/webm" />
          </video>
        ) : featured.preview ? (
          <img src={featured.preview} alt={featured.title} class="block w-full h-full object-cover blur-up" />
        ) : (
          <img src={thumbnailUrl(featured)} alt={featured.title} class="block w-full h-full object-cover blur-up"
            srcset={featuredIds.youtubeId ? thumbnailSrcset(featuredIds.youtubeId) : undefined}
            sizes="(max-width: 1024px) 100vw, 66vw" />
        )}
        <div class="tile-overlay" aria-hidden="true">
          <span class="tile-scrim"></span>
          <span class="tile-badge" data-i18n="hero.badge">À la une</span>
          <span class="tile-play">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
          <div class="tile-meta">
            <span class="tile-cat" data-i18n={catI18n[featured.category || 'youtube']}>{catLabels[featured.category || 'youtube']}</span>
            <h3 class="tile-title">{featured.title}</h3>
            {featured.client && <p class="tile-client">{featured.client}</p>}
          </div>
        </div>
      </article>
      </div>

      <aside class="hero-editorial">
        <span class="hero-available">
          <span class="w-1.5 h-1.5 rounded-full bg-green-400 inline-block"></span>
          <span data-i18n="available">Disponible</span>
        </span>
        <p class="hero-line">Le montage, c'est de l'écriture.</p>
        <p class="hero-sub" data-i18n="hero.fresh">4 nouveaux projets viennent d'arriver.</p>
        <a href="#contact" class="hero-cta magnetic-btn">
          <span data-i18n="hero.cta">Discutons-en</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
      </aside>
    </div>
  </div>
  )}

  <!-- Category filters + bascule Mur / Scène -->
  <div class="flex items-center justify-between gap-4 px-4 md:px-6 pb-6 md:pb-8 reveal-up" id="category-filters-wrapper">
    <div class="glow-card bg-brand-dark/60 backdrop-blur-2xl border border-white/20 rounded-[100px] shadow-2xl shadow-[inset_0_0_30px_-8px_rgba(255,255,255,0.07)] px-5 md:px-6 py-2 relative overflow-hidden">
      <div class="filters-fade filters-fade-left"></div>
      <div class="filters-fade filters-fade-right"></div>
      <div class="overflow-x-auto py-1" style="-ms-overflow-style:none;scrollbar-width:none" id="category-filters">
        <div class="flex flex-nowrap justify-start gap-3">
        {categories.map((cat) => (
          <button
            class="cat-btn px-3 md:px-4 py-1.5 text-[10px] md:text-[11px] uppercase tracking-widest border rounded-full transition-all duration-300 border-brand-white/10 text-brand-gray-400 hover:border-brand-accent hover:text-brand-accent hover:brightness-125 hover:-translate-y-0.5 whitespace-nowrap shrink-0 bg-transparent my-1.5 mx-0.5"
            data-category={cat.id}
            data-i18n={`categories.${cat.id === 'court-metrage' ? 'courtMetrage' : cat.id === 'reseaux-sociaux' ? 'reseauxSociaux' : cat.id}`}
          >
            {cat.label}
          </button>
        ))}
        </div>
      </div>
    </div>

    <div id="view-toggle" class="hidden md:flex items-center text-[10px] md:text-[11px] uppercase tracking-widest bg-brand-dark/60 backdrop-blur-2xl border border-white/20 rounded-full overflow-hidden shadow-xl shrink-0" role="group" aria-label="Vue">
      <button class="view-btn px-4 py-2 transition-colors duration-300 text-brand-gray-400 hover:text-brand-white" data-view="wall" data-i18n="view.wall">Mur</button>
      <button class="view-btn px-4 py-2 transition-colors duration-300 text-brand-gray-400 hover:text-brand-white" data-view="scene" data-i18n="view.scene">Scène</button>
    </div>
  </div>

  <!-- Empty state -->
  <div class="hidden text-center py-16 reveal-up" id="projects-empty">
    <p class="text-brand-gray-400 text-sm" data-i18n="projects.empty">Aucun projet dans cette catégorie.</p>
  </div>

  <!-- Masonry container -->
   <div class="relative w-full" id="projects-grid">
    {rest.map((project, i) => {
      const ids = resolveVideoIds(project);
      const hasVideo = !!(project.videoUrl || project.videoFile || ids.youtubeId || ids.vimeoId || (project.preview && /\.(mp4|webm|mov)$/i.test(project.preview)));
      const ratioClass = aspectClass(project.aspectRatio || '16:9');

      const isFirst = i === 0;
      return (
      <article
        class={`project-card group overflow-hidden bg-brand-gray-900 border-0 reveal-up rounded-[14px] ${ratioClass}`}
        style={`transition-delay: ${(i % 4) * 0.06}s; view-transition-name: project-${project.id}`}
        data-category={project.category || 'youtube'}
        data-youtube={ids.youtubeId}
        data-vimeo={ids.vimeoId}
        data-title={project.title}
        data-video={project.videoUrl || ''}
        data-video-file={project.videoFile || ''}
        data-preview={project.preview || ''}
        data-client={project.client || ''}
        data-description={project.description || ''}
        data-tags={(project.tags || []).join(',')}
        data-aspect={project.aspectRatio || '16:9'}
        data-order={project.order}
        tabindex={hasVideo || project.preview ? '0' : undefined}
        role={hasVideo || project.preview ? 'button' : undefined}
        aria-label={hasVideo || project.preview ? project.title : undefined}
        onclick={hasVideo || project.preview ? 'openVideo(this)' : undefined}
      >
        {project.preview && /\.(mp4|webm|mov)$/i.test(project.preview) ? (
          <video loop muted playsinline preload="none"
            poster={posterUrl(project.preview)}
            class="block w-full h-full object-cover lazy-video blur-up"
          >
            <source src={project.preview} type="video/webm" />
          </video>
        ) : project.preview ? (
          <img src={project.preview} alt={project.title}
            class="block w-full h-full object-cover blur-up"
            loading={isFirst ? undefined : 'lazy'}
            fetchpriority={isFirst ? 'high' : undefined}
          />
        ) : (
          <img
            src={thumbnailUrl(project)}
            alt={project.title}
            class="block w-full h-full object-cover blur-up"
            loading={isFirst ? undefined : 'lazy'}
            fetchpriority={isFirst ? 'high' : undefined}
            srcset={ids.youtubeId ? thumbnailSrcset(ids.youtubeId) : undefined}
            sizes="(max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw"
          />
        )}
        <div class="tile-overlay" aria-hidden="true">
          <span class="tile-scrim"></span>
          <span class="tile-play">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
          <div class="tile-meta">
            <span class="tile-cat" data-i18n={catI18n[project.category || 'youtube']}>{catLabels[project.category || 'youtube']}</span>
            <h3 class="tile-title">{project.title}</h3>
            {project.client && <p class="tile-client">{project.client}</p>}
          </div>
        </div>
      </article>
      );
    })}
    <!-- Portfolio fillers (hidden by default, used to fill last-row gaps) -->
    {Array.from({ length: 5 }).map(() => (
      <article
        class="portfolio-filler hidden group overflow-hidden bg-brand-gray-900 border-0 reveal-up rounded-[14px] aspect-video"
        data-filler="16:9"
        data-aspect="16:9"
        aria-hidden="true"
      >
        <video src="/projects/portfolio-16x9.webm" poster="/projects/portfolio-16x9-poster.webp" loop muted playsinline preload="none" class="block w-full h-full object-cover lazy-video blur-up"></video>
      </article>
    ))}
    {Array.from({ length: 8 }).map(() => (
      <article
        class="portfolio-filler hidden group overflow-hidden bg-brand-gray-900 border-0 reveal-up rounded-[14px] aspect-[9/16]"
        data-filler="9:16"
        data-aspect="9:16"
        aria-hidden="true"
      >
        <video src="/projects/portfolio-9x16.webm" poster="/projects/portfolio-9x16-poster.webp" loop muted playsinline preload="none" class="block w-full h-full object-cover lazy-video blur-up"></video>
      </article>
    ))}
  </div>

  <!-- Hidden card storage for filtered-out cards -->
  <div id="hidden-cards" style="display:none" aria-hidden="true"></div>

  <!-- Scène 3D (vue secondaire) -->
  <div id="scene" class="relative z-10 px-4 md:px-6 pb-12" style="display:none" aria-hidden="true">
    <div id="scene-viewport" class="relative mx-auto max-w-6xl h-[58vh] min-h-[380px] max-h-[560px]" style="perspective:1600px">
      <div id="scene-track" class="absolute inset-0" style="transform-style:preserve-3d"></div>
      <button id="scene-prev" class="scene-arrow left-0 md:-left-5" aria-label="Projet précédent">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/></svg>
      </button>
      <button id="scene-next" class="scene-arrow right-0 md:-right-5" aria-label="Projet suivant">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/></svg>
      </button>
    </div>
    <div class="mx-auto max-w-6xl mt-6 flex items-center justify-between gap-6">
      <div class="min-w-0">
        <p id="scene-title" class="font-heading italic text-xl md:text-2xl text-brand-white truncate"></p>
        <p id="scene-client" class="text-[11px] uppercase tracking-widest text-brand-gray-400 mt-1 truncate"></p>
      </div>
      <button id="scene-open" class="shrink-0 px-6 py-3 rounded-full bg-brand-accent text-white text-xs uppercase tracking-widest hover:bg-brand-accent-bright transition-colors duration-300 shadow-lg shadow-brand-accent/30" data-i18n="scene.open">Voir le projet</button>
    </div>
  </div>
</section>

<dialog
  class="fixed inset-0 z-[60] m-0 h-full w-full max-w-none bg-transparent p-0"
  id="video-modal"
  aria-modal="true"
  role="dialog"
>
  <!-- Wave background video -->
  <div class="fixed inset-0 z-0 pointer-events-none">
    <video
      autoplay loop muted playsinline preload="auto"
      class="absolute inset-0 h-full w-full object-cover"
      id="modal-bg-video"
    >
      <source src="/background-wave.webm" type="video/webm" />
    </video>
    <div class="absolute inset-0 bg-brand-black/60"></div>
  </div>
  <!-- Content -->
  <div class="flex h-full flex-col items-center justify-center p-3 md:p-6" style="cursor:auto;">
    <div class="w-full max-w-6xl" style="cursor:auto;" id="modal-content-wrapper">
      <!-- Glass card -->
      <div class="relative tilt-only bg-brand-dark/90 md:bg-brand-dark/70 md:backdrop-blur-2xl border border-white/20 rounded-[40px] shadow-2xl shadow-brand-accent/10 shadow-[inset_0_0_30px_-8px_rgba(255,255,255,0.07)]" data-tilt-max="4">
        <!-- Close button -->
        <div class="flex justify-end pt-3 pr-3 md:pt-4 md:pr-4 pb-3 md:pb-4">
          <button
            onclick="closeModal()"
            aria-label="Fermer"
            class="group flex items-center justify-center w-8 h-8 md:w-10 md:h-10 rounded-full bg-brand-accent/90 hover:bg-brand-accent hover:scale-110 active:scale-95 transition-all duration-300 shadow-lg shadow-brand-accent/30"
          >
            <svg class="w-3.5 h-3.5 md:w-4 md:h-4 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round">
              <path d="M6 6l12 12M18 6l-12 12" />
            </svg>
          </button>
        </div>
        <!-- Player -->
        <div class="relative aspect-video w-full bg-transparent" id="modal-player"></div>
        <!-- Metadata -->
        <div class="px-5 md:px-6 py-4 md:py-5 space-y-2" id="modal-meta">
          <div class="flex items-start justify-between gap-4">
            <h3 class="font-heading text-lg md:text-xl text-brand-white" id="modal-title"></h3>
            <span class="shrink-0 text-[10px] uppercase tracking-widest text-brand-accent bg-brand-accent/10 px-3 py-1 rounded-full" id="modal-category"></span>
          </div>
          <p class="text-brand-gray-400 text-xs md:text-sm leading-relaxed" id="modal-description"></p>
          <div class="flex flex-wrap gap-1.5 pt-1" id="modal-tags"></div>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  const gridEl = document.getElementById('projects-grid')! as HTMLElement;
  let activeCat = 'all';

  // Save filler templates once (preserve across DOM rebuilds)
  const filler169HTML = document.querySelector('.portfolio-filler[data-filler="16:9"]')?.outerHTML;
  const filler916HTML = document.querySelector('.portfolio-filler[data-filler="9:16"]')?.outerHTML;

  // Grid constants
  function rowCols169() {
    const w = window.innerWidth;
    if (w < 640) return 2;
    if (w < 1024) return 3;
    return 5;
  }
  function rowCols916() {
    const w = window.innerWidth;
    if (w < 640) return 3;
    if (w < 1024) return 5;
    return 8;
  }

  function layoutRows() {
    // Collect fillers BEFORE clearing grid (they live inside #projects-grid)
    // Collect all visible non-filler articles, sorted by data-order
    const articles = [...gridEl.querySelectorAll('article')].filter(c =>
      !c.classList.contains('portfolio-filler') && (c as HTMLElement).style.display !== 'none'
    ).sort((a, b) => {
      const oa = parseInt((a as HTMLElement).getAttribute('data-order') || '9999', 10);
      const ob = parseInt((b as HTMLElement).getAttribute('data-order') || '9999', 10);
      return oa - ob;
    });

    const cards169 = articles.filter(c =>
      !c.classList.contains('aspect-[9/16]') && !c.classList.contains('aspect-square')
    );
    const cards916 = articles.filter(c =>
      c.classList.contains('aspect-[9/16]') || c.classList.contains('aspect-square')
    );

    const cols169 = rowCols169();
    const cols916 = rowCols916();

    // Clear grid
    while (gridEl.firstChild) gridEl.firstChild.remove();

    let i169 = 0, i916 = 0, rowIndex = 0;

    while (i169 < cards169.length || i916 < cards916.length) {
      const row = document.createElement('div');
      let placed = 0;

      if (rowIndex % 2 === 0) {
        // 16:9 row
        const take = Math.min(cols169, cards169.length - i169);
        row.className = 'grid-row';
        row.style.cssText = `display:grid;grid-template-columns:repeat(${cols169},1fr);gap:6px`;
        for (let i = 0; i < take; i++) {
          row.appendChild(cards169[i169 + i]);
          placed++;
        }
        i169 += take;
        // Fill remaining slots with 169 fillers
        if (placed > 0 && placed < cols169 && filler169HTML) {
          for (let f = 0; f < cols169 - placed; f++) {
            const temp = document.createElement('div');
            temp.innerHTML = filler169HTML;
            const filler = temp.firstElementChild as HTMLElement;
            filler.style.display = '';
            filler.classList.remove('hidden', 'reveal-up');
            filler.classList.add('visible');
            row.appendChild(filler);
          }
        }
      } else {
        // 9:16 row
        const take = Math.min(cols916, cards916.length - i916);
        row.className = 'grid-row';
        row.style.cssText = `display:grid;grid-template-columns:repeat(${cols916},1fr);gap:6px`;
        for (let i = 0; i < take; i++) {
          row.appendChild(cards916[i916 + i]);
          placed++;
        }
        i916 += take;
        // Fill remaining slots with 916 fillers
        if (placed > 0 && placed < cols916 && filler916HTML) {
          for (let f = 0; f < cols916 - placed; f++) {
            const temp = document.createElement('div');
            temp.innerHTML = filler916HTML;
            const filler = temp.firstElementChild as HTMLElement;
            filler.style.display = '';
            filler.classList.remove('hidden', 'reveal-up');
            filler.classList.add('visible');
            row.appendChild(filler);
          }
        }
      }

      if (row.children.length > 0) gridEl.appendChild(row);
      rowIndex++;
    }

    // Re-observe lazy videos after DOM rebuild
    document.querySelectorAll('.lazy-video').forEach(v => {
      if (!videoObserver) return;
      videoObserver.observe(v);
    });
    // Re-observe video blurs (handled by play() promise in processPlayQueue)
    document.querySelectorAll('img.blur-up').forEach(resolveBlurUp);
  }

  // Debounced resize
  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      layoutRows();
      updateScrollFade();
      if (sceneMode) layoutScene();
    }, 200);
  });

  // ── Lazy-load preview videos — staggered, visual order ──
  // Only trigger play() when videos are truly in viewport (rootMargin: 0)
  // Queue is sorted by DOM document position (left→right, top→bottom)
  // Controls cadence to avoid main-thread jank from parallel media init
  const videoPlayQueue: HTMLVideoElement[] = [];
  let videoPlaying = false;

  function processPlayQueue() {
    if (videoPlaying || videoPlayQueue.length === 0) return;
    videoPlaying = true;

    // Sort queue by visual DOM order (left→right, top→bottom)
    videoPlayQueue.sort((a, b) => {
      const aArt = a.closest('article');
      const bArt = b.closest('article');
      if (!aArt || !bArt) return 0;
      const pos = aArt.compareDocumentPosition(bArt);
      if (pos & Node.DOCUMENT_POSITION_FOLLOWING) return -1;
      if (pos & Node.DOCUMENT_POSITION_PRECEDING) return 1;
      return 0;
    });

    const video = videoPlayQueue.shift()!;

    // Start loading + playback (browser handles media init)
    video.play()
      .then(() => {
        // Remove blur when content actually renders
        if (video.classList.contains('blur-up')) video.classList.add('loaded');
      })
      .catch(() => {
        // Even if play fails (network error, autoplay policy), remove blur
        if (video.classList.contains('blur-up')) video.classList.add('loaded');
      });

    // Process next after stagger delay — prevents burst of media pipeline inits
    setTimeout(() => {
      videoPlaying = false;
      processPlayQueue();
    }, 400);
  }

  const lazyMargin = '0px';
  const videoObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const video = entry.target as HTMLVideoElement;
      if (entry.isIntersecting) {
        if (!videoPlayQueue.includes(video) && video.paused) {
          videoPlayQueue.push(video);
          processPlayQueue();
        }
      } else {
        video.pause();
        // Remove from queue
        const idx = videoPlayQueue.indexOf(video);
        if (idx !== -1) videoPlayQueue.splice(idx, 1);
      }
    });
  }, { rootMargin: lazyMargin });

  document.querySelectorAll('.lazy-video').forEach(v => videoObserver.observe(v));

  // Blur-up: images — remove blur on load OR error (broken image)
  function resolveBlurUp(el: Element) {
    const img = el as HTMLImageElement;
    if (img.complete) {
      img.classList.add('loaded');
    } else {
      img.addEventListener('load', () => img.classList.add('loaded'), { once: true });
      img.addEventListener('error', () => img.classList.add('loaded'), { once: true });
    }
  }
  document.querySelectorAll('img.blur-up').forEach(resolveBlurUp);

  // Category filtering
  function updateScrollFade() {
    const container = document.getElementById('category-filters')!;
    const leftFade = document.querySelector('.filters-fade-left') as HTMLElement;
    const rightFade = document.querySelector('.filters-fade-right') as HTMLElement;
    if (!leftFade || !rightFade) return;
    const canScroll = container.scrollWidth > container.clientWidth;
    if (!canScroll) {
      leftFade.style.opacity = '0';
      rightFade.style.opacity = '0';
      return;
    }
    leftFade.style.opacity = container.scrollLeft > 4 ? '1' : '0';
    rightFade.style.opacity = container.scrollLeft < container.scrollWidth - container.clientWidth - 4 ? '1' : '0';
  }

  document.getElementById('category-filters')!.addEventListener('scroll', updateScrollFade, { passive: true });
  setTimeout(updateScrollFade, 200);

  function updateFilters(cat: string) {
    activeCat = cat;
    const hiddenEl = document.getElementById('hidden-cards')!;

    // La tuile "à la une" vit dans le bandeau en vue Tout, dans la grille sinon
    const heroCard = document.getElementById('hero-featured');
    const heroSlot = document.getElementById('hero-slot');
    const heroBand = document.getElementById('hero-band');
    if (heroCard && heroSlot) {
      if (cat === 'all') {
        heroSlot.appendChild(heroCard);
      } else if (heroCard.parentElement !== gridEl) {
        gridEl.appendChild(heroCard);
      }
    }
    heroBand && (heroBand.style.display = cat === 'all' ? '' : 'none');

    document.querySelectorAll('.cat-btn').forEach(b => {
      const isActive = b.getAttribute('data-category') === cat;
      b.classList.toggle('border-brand-accent', isActive);
      b.classList.toggle('text-brand-accent', isActive);
      b.classList.toggle('bg-brand-accent/15', isActive);
      b.classList.toggle('border-brand-white/10', !isActive);
      b.classList.toggle('text-brand-gray-400', !isActive);
      b.classList.toggle('bg-transparent', !isActive);
    });

    let visibleCount = 0;
    const cards = document.querySelectorAll('#projects-grid article, #projects-grid .grid-row > article, #hidden-cards article');

    cards.forEach((card) => {
      if (card.classList.contains('portfolio-filler')) return;
      const cardCat = card.getAttribute('data-category') || '';
      const visible = cat === 'all' || cardCat === cat;
      const el = card as HTMLElement;

      if (visible) {
        visibleCount++;
        el.style.display = '';
        el.classList.remove('filtered-out');
        // Move back to grid (layoutRows re-orders by aspect ratio)
        if (el.parentElement?.id === 'hidden-cards') {
          gridEl.appendChild(el);
        }
      } else {
        el.classList.add('filtered-out');
        el.style.display = 'none';
        // Move to hidden container from grid
        if (el.parentElement?.id !== 'hidden-cards') {
          hiddenEl.appendChild(el);
        }
      }
    });

    layoutRows();

    const emptyEl = document.getElementById('projects-empty')!;
    if (visibleCount === 0) {
      gridEl.style.display = 'none';
      emptyEl.classList.remove('hidden');
      emptyEl.classList.add('visible');
    } else {
      gridEl.style.display = '';
      emptyEl.classList.add('hidden');
      emptyEl.classList.remove('visible');
    }
  }

  // Init
  updateFilters('all');
  setTimeout(() => layoutRows(), 50);
  setTimeout(() => layoutRows(), 150);
  window.addEventListener('load', () => { layoutRows(); updateScrollFade(); });

  document.querySelectorAll('.cat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category')!;
      if (cat === activeCat) return;
      gridEl.classList.add('is-filtering');
      setTimeout(() => {
        updateFilters(cat);
        requestAnimationFrame(() => gridEl.classList.remove('is-filtering'));
      }, 170);
    });
  });

  // Video modal
  const modal = document.getElementById('video-modal') as HTMLDialogElement | null;
  let modalAnimating = false;

  function extractYtId(url: string): string | null {
    const m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/|youtube\.com\/shorts\/)([a-zA-Z0-9_-]{11})/);
    return m ? m[1] : null;
  }

  function catLabel(id: string): string {
    const map: Record<string, string> = {
      youtube: 'YouTube',
      'court-metrage': document.documentElement.lang === 'fr' ? 'Court-Métrage' : 'Short Film',
      'reseaux-sociaux': document.documentElement.lang === 'fr' ? 'Réseaux Sociaux' : 'Social Media',
    };
    return map[id] || id;
  }

  (window as any).openVideo = function(el: HTMLElement) {
    const videoFile = el.dataset.videoFile || '';
    const videoUrl = el.dataset.video || '';
    const youtubeId = el.dataset.youtube || '';
    const preview = el.dataset.preview || '';
    const title = el.dataset.title || '';
    const client = el.dataset.client || '';
    const description = el.dataset.description || '';
    const tags = (el.dataset.tags || '').split(',').filter(Boolean);
    const category = el.dataset.category || '';
    const aspect = el.dataset.aspect || '16:9';

    // Adjust modal layout for 9:16 videos
    const contentWrapper = document.getElementById('modal-content-wrapper');
    const playerDiv = document.getElementById('modal-player');
    if (contentWrapper) {
      contentWrapper.className = aspect === '9:16'
        ? 'w-full max-w-[420px] mx-auto'
        : 'w-full max-w-6xl';
    }
    if (playerDiv) {
      playerDiv.className = aspect === '9:16'
        ? 'relative aspect-[9/16] w-full bg-transparent'
        : 'relative aspect-video w-full bg-transparent';
    }

    // Instagram → new tab (can't embed)
    if (videoUrl && videoUrl.includes('instagram.com')) {
      window.open(videoUrl, '_blank', 'noopener,noreferrer');
      return;
    }

    if (!modal || modalAnimating) return;

    // Populate metadata
    const titleEl = document.getElementById('modal-title');
    const catEl = document.getElementById('modal-category');
    const descEl = document.getElementById('modal-description');
    const tagsEl = document.getElementById('modal-tags');

    if (titleEl) titleEl.textContent = title;
    if (catEl) catEl.textContent = client || catLabel(category);
    if (descEl) descEl.textContent = description;
    if (tagsEl) {
      tagsEl.innerHTML = '';
      tags.forEach(t => {
        const lang = document.documentElement.lang || 'fr';
        const dict = (window as any).__tagsDict || {};
        const translated = dict[t] ? dict[t][lang as 'fr' | 'en'] : t;
        const span = document.createElement('span');
        span.className = 'px-2.5 py-0.5 text-[9px] uppercase tracking-wider border rounded-full border-brand-white/10 text-brand-gray-400 bg-brand-white/5';
        span.textContent = translated;
        tagsEl.appendChild(span);
      });
    }

    const ytId = youtubeId || extractYtId(videoUrl);
    const container = modal.querySelector('#modal-player')!;
    container.innerHTML = '';

    // En dev, la Function Cloudflare /yt-thumb n'est pas servie → image YouTube directe
    const ytImg = (size: string) => import.meta.env.DEV
      ? `https://img.youtube.com/vi/${ytId}/${size}.jpg`
      : `/yt-thumb/${ytId}?size=${size}`;

    if (ytId) {
      const facade = document.createElement('div');
      facade.className = 'absolute inset-0 cursor-pointer group/facade';
      facade.innerHTML = `
        <img src="${ytImg('maxresdefault')}" alt="" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/30 group-hover/facade:bg-black/50 transition-colors duration-300 flex items-center justify-center">
          <div class="w-14 h-14 md:w-20 md:h-20 rounded-full bg-brand-accent flex items-center justify-center group-hover/facade:scale-110 transition-transform duration-300 shadow-lg shadow-brand-accent/40">
            <svg class="w-6 h-6 md:w-8 md:h-8 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </div>
        </div>`;
      // Fallbacks sans boucle : maxres → poster local (frame de la vidéo) → hq → masquée
      const thumb = facade.querySelector('img') as HTMLImageElement | null;
      const localPoster = preview ? preview.replace(/\.(webm|mp4|mov)$/i, '-poster.webp') : '';
      const thumbSources = [ytImg('maxresdefault'), ...(localPoster ? [localPoster] : []), ytImg('hqdefault')];
      let thumbIdx = 0;
      const nextThumb = () => {
        thumbIdx++;
        if (!thumb) return;
        if (thumbIdx < thumbSources.length) thumb.src = thumbSources[thumbIdx];
        else thumb.style.visibility = 'hidden';
      };
      thumb?.addEventListener('error', nextThumb);
      // YouTube sert un placeholder 120x90 (statut 404) quand la maxres n'existe pas :
      // le navigateur le décode sans "error", donc on le détecte à la taille.
      thumb?.addEventListener('load', () => {
        if (thumb.naturalWidth <= 120) nextThumb();
      });
      facade.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&rel=0`;
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.className = 'absolute inset-0 w-full h-full border-0';
        facade.replaceWith(iframe);
      });
      container.appendChild(facade);
    } else if (videoFile) {
      // Local video file
      const video = document.createElement('video');
      video.controls = true;
      video.autoplay = true;
      video.className = 'absolute inset-0 h-full w-full border-0 object-contain';
      const vSrc = document.createElement('source');
      vSrc.src = videoFile.replace(/\.(mp4|mov)$/i, '.webm');
      vSrc.type = 'video/webm';
      video.appendChild(vSrc);
      container.appendChild(video);
    } else if (preview) {
      // Preview file (video or image)
      const isVideo = /\.(mp4|webm|mov)$/i.test(preview);
      if (isVideo) {
        const video = document.createElement('video');
        video.controls = true;
        video.autoplay = true;
        video.className = 'absolute inset-0 h-full w-full border-0 object-contain';
        const vSrc = document.createElement('source');
        vSrc.src = preview.replace(/\.(mp4|mov)$/i, '.webm');
        vSrc.type = 'video/webm';
        video.appendChild(vSrc);
        container.appendChild(video);
      } else {
        const img = document.createElement('img');
        img.src = preview;
        img.alt = title;
        img.className = 'absolute inset-0 h-full w-full border-0 object-contain';
        container.appendChild(img);
      }
    } else {
      // Fallback: open in new tab
      window.open(videoUrl, '_blank', 'noopener,noreferrer');
      return;
    }

    const wrapper = modal.firstElementChild as HTMLElement;
    wrapper.style.opacity = '0';
    wrapper.style.transform = 'scale(0.92)';
    wrapper.style.transition = 'opacity 0.35s ease-out, transform 0.35s ease-out';

    modal.showModal();
    // Start modal background video
    const bgVideo = document.getElementById('modal-bg-video') as HTMLVideoElement | null;
    if (bgVideo) { bgVideo.currentTime = 0; bgVideo.play().catch(() => {}); }
    document.body.style.overflow = 'hidden';
    // Focus the close button
    const closeBtn = modal.querySelector('button') as HTMLButtonElement | null;
    if (closeBtn) setTimeout(() => closeBtn.focus(), 100);

    requestAnimationFrame(() => {
      wrapper.style.opacity = '1';
      wrapper.style.transform = 'scale(1)';
    });

    const dot = document.getElementById('cursor-dot');
    if (dot) dot.style.display = 'none';
  };

  (window as any).closeModal = function() {
    if (!modal || modalAnimating) return;
    modalAnimating = true;

    modal.close();
    document.body.style.overflow = '';
    const dot = document.getElementById('cursor-dot');
    if (dot) dot.style.display = '';
    modalAnimating = false;
  };

  if (modal) {
    // Focus trap
    function getFocusableElements(): HTMLElement[] {
      const els = modal!.querySelectorAll<HTMLElement>(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      return Array.from(els).filter(el => !!(el as HTMLElement).offsetParent);
    }

    function trapFocus(e: KeyboardEvent) {
      if (e.key !== 'Tab' || !modal!.open) return;
      const focusable = getFocusableElements();
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) { e.preventDefault(); last.focus(); }
      } else {
        if (document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }

    document.addEventListener('keydown', trapFocus);

    // Swipe to close
    let touchStartY = 0;
    modal.addEventListener('touchstart', (e) => {
      touchStartY = (e as TouchEvent).touches[0].clientY;
    }, { passive: true });

    modal.addEventListener('touchend', (e) => {
      const deltaY = (e as TouchEvent).changedTouches[0].clientY - touchStartY;
      const target = e.target as HTMLElement;
      if (deltaY > 60 && !target.closest('button, a, input')) {
        (window as any).closeModal();
      }
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) (window as any).closeModal();
    });
    modal.addEventListener('close', () => {
      const container = modal.querySelector('#modal-player');
      if (container) container.innerHTML = '';
      // Reset modal layout to default (16:9)
      const contentWrapper = document.getElementById('modal-content-wrapper');
      const playerDiv = document.getElementById('modal-player');
      if (contentWrapper) contentWrapper.className = 'w-full max-w-6xl';
      if (playerDiv) playerDiv.className = 'relative aspect-video w-full bg-transparent';
      const titleEl = document.getElementById('modal-title');
      const descEl = document.getElementById('modal-description');
      const tagsEl = document.getElementById('modal-tags');
      if (titleEl) titleEl.textContent = '';
      if (descEl) descEl.textContent = '';
      if (tagsEl) tagsEl.innerHTML = '';
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.open) (window as any).closeModal();
    });
  }

  // ── Activation clavier des tuiles ─────────────────────
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (!t?.matches?.('.project-card[role="button"]')) return;
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      (window as any).openVideo(t);
    }
  });

  // ── Scène 3D (vue secondaire) ─────────────────────────
  const sceneEl = document.getElementById('scene');
  const sceneTrack = document.getElementById('scene-track');
  const sceneViewport = document.getElementById('scene-viewport');
  const sceneTitle = document.getElementById('scene-title');
  const sceneClient = document.getElementById('scene-client');
  let sceneMode = false;
  let sceneItems: { el: HTMLElement; article: HTMLElement }[] = [];
  let sceneIdx = 0;
  let sceneLock = 0;
  let sceneVideo: HTMLVideoElement | null = null;
  let sceneVideoArticle: HTMLElement | null = null;

  function visibleArticles(): HTMLElement[] {
    const heroCard = document.getElementById('hero-featured');
    const list = ([...gridEl.querySelectorAll('article')] as HTMLElement[]);
    if (heroCard && heroCard.parentElement?.id === 'hero-slot') list.push(heroCard);
    return list
      .filter(a => !a.classList.contains('portfolio-filler')
        && a.style.display !== 'none'
        && a.parentElement?.id !== 'hidden-cards'
        && a.getAttribute('data-order') !== null)
      .sort((a, b) => parseInt(a.getAttribute('data-order') || '0', 10) - parseInt(b.getAttribute('data-order') || '0', 10));
  }

  function releaseSceneVideo() {
    if (sceneVideo && sceneVideoArticle) {
      sceneVideo.pause();
      sceneVideo.classList.remove('scene-video');
      sceneVideoArticle.insertBefore(sceneVideo, sceneVideoArticle.firstChild);
    }
    sceneVideo = null;
    sceneVideoArticle = null;
  }

  function buildScene() {
    if (!sceneTrack) return;
    releaseSceneVideo();
    sceneTrack.innerHTML = '';
    sceneItems = visibleArticles().map((article, i) => {
      const el = document.createElement('div');
      el.className = 'scene-item';
      const aspect = article.getAttribute('data-aspect') || '16:9';
      el.style.aspectRatio = aspect === '9:16' ? '9 / 16' : aspect === '1:1' ? '1 / 1' : '16 / 9';
      const video = article.querySelector('video');
      const img = article.querySelector('img');
      const poster = video?.getAttribute('poster') || img?.getAttribute('src') || '';
      const im = document.createElement('img');
      im.src = poster;
      im.alt = '';
      im.className = 'scene-poster';
      im.draggable = false;
      el.appendChild(im);
      el.addEventListener('click', () => {
        if (i === sceneIdx) (window as any).openVideo(article);
        else activateScene(i);
      });
      sceneTrack!.appendChild(el);
      return { el, article };
    });
    sceneIdx = Math.min(sceneIdx, Math.max(0, sceneItems.length - 1));
  }

  function activateScene(i: number) {
    if (!sceneItems.length) return;
    releaseSceneVideo();
    sceneIdx = Math.max(0, Math.min(sceneItems.length - 1, i));
    const { el, article } = sceneItems[sceneIdx];
    const vid = article.querySelector('video');
    if (vid) {
      vid.classList.add('scene-video');
      el.appendChild(vid);
      sceneVideo = vid;
      sceneVideoArticle = article;
      vid.play().catch(() => {});
    }
    if (sceneTitle) sceneTitle.textContent = article.dataset.title || '';
    if (sceneClient) sceneClient.textContent = article.dataset.client || '';
    layoutScene();
  }

  function layoutScene() {
    if (!sceneItems.length) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const w = sceneItems[sceneIdx].el.offsetWidth || 480;
    sceneItems.forEach((it, i) => {
      const off = i - sceneIdx;
      const abs = Math.abs(off);
      const x = off * w * 0.58;
      const rotY = reduce || off === 0 ? 0 : -Math.sign(off) * 32;
      const z = reduce ? 0 : -abs * 170;
      const scale = reduce ? 1 : Math.max(0.7, 1 - abs * 0.1);
      const op = abs === 0 ? 1 : Math.max(0.2, 0.72 - (abs - 1) * 0.26);
      it.el.style.transform = `translate(-50%, -50%) translateX(${x}px) translateZ(${z}px) rotateY(${rotY}deg) scale(${scale})`;
      it.el.style.opacity = String(op);
      it.el.style.zIndex = String(200 - abs);
      it.el.classList.toggle('is-active', abs === 0);
    });
  }

  function setView(mode: 'wall' | 'scene') {
    const next = mode === 'scene';
    if (next === sceneMode) return;
    sceneMode = next;
    document.querySelectorAll('.view-btn').forEach(b => {
      const on = b.getAttribute('data-view') === mode;
      b.classList.toggle('bg-brand-accent', on);
      b.classList.toggle('text-white', on);
      b.classList.toggle('text-brand-gray-400', !on);
    });
    const heroBand = document.getElementById('hero-band');
    const filtersWrap = document.getElementById('category-filters-wrapper');
    if (sceneMode) {
      if (heroBand) heroBand.style.display = 'none';
      if (filtersWrap) filtersWrap.style.display = 'none';
      gridEl.style.display = 'none';
      if (sceneEl) sceneEl.style.display = '';
      buildScene();
      activateScene(0);
    } else {
      releaseSceneVideo();
      if (sceneEl) sceneEl.style.display = 'none';
      gridEl.style.display = '';
      if (filtersWrap) filtersWrap.style.display = '';
      if (activeCat === 'all' && heroBand) heroBand.style.display = '';
      layoutRows();
    }
  }

  document.querySelectorAll('.view-btn').forEach(btn => {
    btn.addEventListener('click', () => setView((btn.getAttribute('data-view') as 'wall' | 'scene') || 'wall'));
    const on = btn.getAttribute('data-view') === 'wall';
    btn.classList.toggle('bg-brand-accent', on);
    btn.classList.toggle('text-white', on);
    btn.classList.toggle('text-brand-gray-400', !on);
  });
  document.getElementById('scene-prev')?.addEventListener('click', () => activateScene(sceneIdx - 1));
  document.getElementById('scene-next')?.addEventListener('click', () => activateScene(sceneIdx + 1));
  document.getElementById('scene-open')?.addEventListener('click', () => {
    const a = sceneItems[sceneIdx]?.article;
    if (a) (window as any).openVideo(a);
  });

  sceneViewport?.addEventListener('wheel', (e) => {
    if (!sceneMode) return;
    e.preventDefault();
    const now = Date.now();
    if (now - sceneLock < 320) return;
    const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
    if (Math.abs(delta) < 8) return;
    sceneLock = now;
    activateScene(sceneIdx + (delta > 0 ? 1 : -1));
  }, { passive: false });

  let sceneDragX = 0;
  let sceneDragging = false;
  sceneViewport?.addEventListener('pointerdown', (e) => { sceneDragging = true; sceneDragX = e.clientX; });
  sceneViewport?.addEventListener('pointerup', (e) => {
    if (!sceneDragging) return;
    sceneDragging = false;
    const dx = e.clientX - sceneDragX;
    if (Math.abs(dx) > 60) activateScene(sceneIdx + (dx < 0 ? 1 : -1));
  });

  document.addEventListener('keydown', (e) => {
    if (!sceneMode) return;
    if (e.key === 'ArrowLeft') activateScene(sceneIdx - 1);
    if (e.key === 'ArrowRight') activateScene(sceneIdx + 1);
    if (e.key === 'Escape' && !modal?.open) setView('wall');
  });
</script>

<style>
  #projects-grid {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  #projects-grid > article,
  #projects-grid .grid-row > article,
  #hero-slot > article {
    position: relative;
    width: 100%;
  }
</style>
